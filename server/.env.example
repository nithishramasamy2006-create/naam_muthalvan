# NM MicroLearn Server Environment Variables
# Copy this file to .env and fill in your values

# MongoDB — use MongoDB Atlas connection string for production
MONGO_URI=mongodb://localhost:27017/nm_microlearn

# Server port
PORT=5000

# JWT secret (change this to a long random string in production)
JWT_SECRET=nm_microlearn_jwt_secret_2026_tnsdc

# JWT expiry
JWT_EXPIRES_IN=7d

# Node environment
NODE_ENV=development
